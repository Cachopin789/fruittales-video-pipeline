@{
    # Se usa cuando no existe assets/marca.png
    MarcaTexto       = '@FruitTalesES'
    Fuente           = 'C:/Windows/Fonts/arialbd.ttf'
    TamanoFuentePx   = 42
    OpacidadMarca    = 0.78

    # Posición de la marca: arriba-derecha, con este margen
    MargenPx         = 44
    EscalaLogoPx     = 190

    Ancho            = 1080
    Alto             = 1920
    CalidadCrf       = 20
    Preset           = 'medium'

    # Mejora visual previa a la marca: limpieza suave y nitidez moderada.
    # Desactívala si el original ya se ve muy nítido o tiene grano intencional.
    MejoraActiva     = $true
    ReduccionRuido   = 1.2
    Nitidez          = 0.55
}
